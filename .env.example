# Copy this file to .env and fill in your values
# .env is gitignored — never commit it

# Brave Search API key (https://brave.com/search/api/)
WEB_SEARCH_API_KEY=your_brave_search_api_key_here

# Override LLM settings if needed (defaults come from config.yaml).
# Only affects the top-level `llm:` block (per-item summarise/classify/verify)
# — the digest model is set separately under `llm.digest` in config.yaml.
# LLM_BASE_URL=http://127.0.0.1:11435/v1
# LLM_MODEL=apple-foundationmodel
